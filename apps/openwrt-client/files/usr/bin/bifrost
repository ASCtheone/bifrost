#!/bin/sh
# bifrost — OpenWrt/GL.iNet client for the Bifrost VPN.
#
# Onboards by device code: on first boot it asks the master for a short code,
# which the account owner claims in the dashboard; the master hands back a
# provision token (via the router's callback, or by the router polling). The
# router then fetches its WireGuard config from the hard-bound master and brings
# up a tunnel to a spark — either a chosen location or, on "auto", the primary
# with failover to the next available node and automatic return to primary.
#
# A kill switch (optional) blocks LAN clients from reaching the internet unless
# their traffic goes through the tunnel — including while connecting/switching.
#
# Usage: bifrost {bootstrap|save-token <t>|poll|up|down|status|json|refresh|run}
set -u

CONFIG=bifrost
STATE_DIR="${BIFROST_STATE_DIR:-/tmp/bifrost}"   # overridable for tests only
RESP="$STATE_DIR/provision.json"
WGTMP="$STATE_DIR/wg.conf"
HASHFILE="$STATE_DIR/applied.hash"
CURNODE="$STATE_DIR/current.node"
APPLIED="$STATE_DIR/applied.conf"          # last config that actually handshook
PRIMARY_BACKOFF="$STATE_DIR/primary.backoff" # "<next attempt epoch> <failures> <primary nodeId>"
PRIMARY_BACKOFF_MAX=3600
NODES_REPORT="$STATE_DIR/nodes.report"      # "<nodeId> ok|fail <epoch>" — last handshake result per spark
RXSTATE="$STATE_DIR/rx.last"                # "<rx bytes> <epoch they last changed>"
SAFE_RECOVER_TICKS=12                       # watchdog safe mode re-probes nodes every 12 ticks (~60 s)
RX_STALL_MAX=35                             # no bytes in for this long → confirm with a ping
# Hard-bound control plane. Override only for self-hosting via
# `uci set bifrost.settings.master_url=...`.
MASTER_DEFAULT="https://dash.asc.ninja/bifrost"
KS_CHAIN=bifrost_ks
BIFROST_VERSION=0.9.29
# Self-update: a persistent backup + pending marker (STATE_DIR=/tmp is volatile).
UPDATE_DIR="${BIFROST_UPDATE_DIR:-/etc/bifrost}"
BAK="$UPDATE_DIR/bifrost.bak"
PENDING="$UPDATE_DIR/.update-pending"

mkdir -p "$STATE_DIR"

log() { logger -t bifrost "$*"; [ -t 1 ] && echo "bifrost: $*"; }
cfg_get() { uci -q get "${CONFIG}.settings.$1"; }
cfg_set() { uci set "${CONFIG}.settings.$1=$2" && uci commit "$CONFIG"; }

ifname() { local n; n=$(cfg_get ifname); [ -n "$n" ] && echo "$n" || echo bifrost; }
lan_dev() { local d; d=$(uci -q get network.lan.device); [ -n "$d" ] && echo "$d" || echo br-lan; }
lan_ip() { uci -q get network.lan.ipaddr 2>/dev/null || echo 192.168.8.1; }
master() { local m; m=$(cfg_get master_url); [ -n "$m" ] && echo "$m" || echo "$MASTER_DEFAULT"; }
api() { echo "$(master)/api"; }
jget() { jq -r "$2 // empty" 2>/dev/null <<EOF
$1
EOF
}

# ── device-code onboarding ──────────────────────────────────────

callback_url() { echo "http://$(lan_ip):8099/cgi-bin/bifrost"; }

# Ask the master for a pairing code (first boot). Echoes the code.
bootstrap() {
	[ -n "$(cfg_get provision_token)" ] && { log "already registered"; cfg_get device_code; return 0; }
	local code hostname resp
	code=$(cfg_get device_code)
	if [ -z "$code" ]; then
		hostname=$(uci -q get system.@system[0].hostname 2>/dev/null || echo router)
		resp=$(curl -fsS --max-time 15 -X POST "$(api)/device/code" \
			-H 'Content-Type: application/json' \
			-d "{\"name\":\"$hostname\",\"callbackUrl\":\"$(callback_url)\"}" 2>/dev/null)
		code=$(jget "$resp" .deviceCode)
		[ -n "$code" ] || { log "could not obtain a device code from the master"; return 1; }
		cfg_set device_code "$code"
		log "device code issued: $code"
	fi
	echo "$code"
}

# Save the provision token handed back by the dashboard (callback or poll).
# Config-only: the always-running agent picks it up and connects. Never restarts
# procd (that would kill the web UI serving the callback).
save_token() {
	[ -n "${1:-}" ] || { log "save-token: empty token"; return 1; }
	uci set "${CONFIG}.settings.provision_token=$1"
	uci set "${CONFIG}.settings.device_code="
	uci set "${CONFIG}.settings.enabled=1"
	uci commit "$CONFIG"
	log "registered — provision token saved"
}

# Poll the master once for a claimed code; saves the token when registered.
poll_once() {
	local code resp status token
	code=$(cfg_get device_code)
	[ -n "$code" ] || return 1
	resp=$(curl -fsS --max-time 15 "$(api)/device/code/$code" 2>/dev/null) || return 1
	status=$(jget "$resp" .status)
	case "$status" in
		registered)
			token=$(jget "$resp" .provisionToken)
			[ -n "$token" ] && { save_token "$token"; return 0; }
			;;
		expired) log "device code expired"; cfg_set device_code '' ;;
	esac
	return 1
}

# ── config fetch (by provision token, hard-bound master) ────────

fetch_config() {
	local token backup
	token=$(cfg_get provision_token)
	[ -n "$token" ] || { log "not registered yet (no provision token)"; return 1; }
	backup=0; [ -f "$BAK" ] && backup=1
	if ! curl -fsS --max-time 20 \
		-H "X-Bifrost-Version: $BIFROST_VERSION" \
		-H "X-Bifrost-Backup: $backup" \
		-H "X-Bifrost-Safemode: $([ "$(cfg_get safe_mode)" = 1 ] && echo 1 || echo 0)" \
		-H "X-Bifrost-Nodes: $(node_reports_header)" \
		-H "X-Bifrost-Current: $(current_node_header)" \
		"$(api)/provision/$token" -o "$RESP.new" 2>/dev/null; then
		rm -f "$RESP.new"
		log "could not reach master at $(api)"
		return 1
	fi
	# Only replace the cached provision with a complete, valid one — connect() falls
	# back to the cache when the master is unreachable.
	jq -e '.nodes' "$RESP.new" >/dev/null 2>&1 || { rm -f "$RESP.new"; log "unexpected provision response"; return 1; }
	mv "$RESP.new" "$RESP"
	handle_pending_action
	return 0
}

# ── remote self-update (opkg + health-gated auto-downgrade) ─────

# Act on a one-shot update/revert instruction the master returned in the provision poll.
handle_pending_action() {
	[ -f "$PENDING" ] && return 0   # already applying an update — don't stack another
	local action latest
	action=$(jq -r '.pendingAction // empty' "$RESP" 2>/dev/null)
	latest=$(jq -r '.latestVersion // empty' "$RESP" 2>/dev/null)
	case "$action" in
		update) [ -n "$latest" ] && [ "$latest" != "$BIFROST_VERSION" ] && do_update ;;
		revert) do_revert ;;
		unlock) safe_on ;;   # remote unlock override (safe mode) from the dashboard
		resume) safe_off ;;  # remote resume normal operation
	esac
}

# Back up the current script, then upgrade via opkg — detached (setsid) so restarting the
# service mid-upgrade can't kill it. The new version health-gates itself on startup (see
# the `run` loop) and rolls back if it can't reach the master. Single backup slot; kept
# after a healthy update so a manual Revert can restore it.
do_update() {
	mkdir -p "$UPDATE_DIR"
	cp /usr/bin/bifrost "$BAK" 2>/dev/null || { log "self-update: could not back up current version"; return 1; }
	touch "$PENDING"
	log "self-update: upgrading via opkg (detached)"
	setsid sh -c 'sleep 2; opkg update && opkg upgrade bifrost && /etc/init.d/bifrost restart' \
		>/tmp/bifrost-update.log 2>&1 &
}

# Restore the backup script and drop it, then restart into it.
do_revert() {
	[ -f "$BAK" ] || { log "revert: no backup to restore"; return 1; }
	log "revert: restoring the previous version"
	setsid sh -c "sleep 1; cp '$BAK' /usr/bin/bifrost && rm -f '$BAK' '$PENDING' && /etc/init.d/bifrost restart" \
		>/tmp/bifrost-update.log 2>&1 &
}

# ── WireGuard .conf parsing + apply (uci netifd) ────────────────

wg_field() { sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n1; }
sha() { sha256sum "$1" 2>/dev/null | awk '{print $1}' || md5sum "$1" | awk '{print $1}'; }

apply_wg() {
	local iface priv addr dns pub psk ep ephost epport allowed mtu peer d a
	iface=$(ifname)
	priv=$(wg_field "$1" PrivateKey)
	addr=$(wg_field "$1" Address)
	dns=$(wg_field "$1" DNS | tr ',' ' ')
	pub=$(wg_field "$1" PublicKey)
	psk=$(wg_field "$1" PresharedKey)
	ep=$(wg_field "$1" Endpoint)
	ephost=${ep%:*}
	epport=${ep##*:}
	allowed=$(wg_field "$1" AllowedIPs | tr ',' ' ')
	mtu=$(cfg_get mtu); [ -n "$mtu" ] || mtu=1420
	if [ -z "$priv" ] || [ -z "$pub" ] || [ -z "$ephost" ]; then
		log "config missing required WireGuard fields"
		return 1
	fi

	uci -q delete "network.$iface"
	uci set "network.$iface=interface"
	uci set "network.$iface.proto=wireguard"
	uci set "network.$iface.private_key=$priv"
	uci set "network.$iface.mtu=$mtu"
	[ -n "$addr" ] && uci add_list "network.$iface.addresses=$addr"
	for d in $dns; do uci add_list "network.$iface.dns=$d"; done

	while uci -q delete "network.@wireguard_${iface}[0]"; do :; done
	peer=$(uci add network "wireguard_${iface}")
	uci set "network.$peer.public_key=$pub"
	[ -n "$psk" ] && uci set "network.$peer.preshared_key=$psk"
	uci set "network.$peer.endpoint_host=$ephost"
	uci set "network.$peer.endpoint_port=$epport"
	uci set "network.$peer.persistent_keepalive=25"
	uci set "network.$peer.route_allowed_ips=1"
	for a in $allowed; do uci add_list "network.$peer.allowed_ips=$a"; done

	uci commit network
	[ "$(cfg_get route_lan)" = "1" ] && setup_firewall "$iface"
	return 0
}

# ── firewall: route LAN out via the tunnel ──────────────────────

setup_firewall() {
	local iface="$1" i name dest z f
	i=0
	while name=$(uci -q get "firewall.@zone[$i].name"); do
		[ "$name" = "bifrost" ] && uci -q delete "firewall.@zone[$i]" || i=$((i + 1))
	done
	i=0
	while dest=$(uci -q get "firewall.@forwarding[$i].dest"); do
		[ "$dest" = "bifrost" ] && uci -q delete "firewall.@forwarding[$i]" || i=$((i + 1))
	done
	z=$(uci add firewall zone)
	uci set "firewall.$z.name=bifrost"
	uci set "firewall.$z.network=$iface"
	uci set "firewall.$z.input=REJECT"
	uci set "firewall.$z.output=ACCEPT"
	uci set "firewall.$z.forward=REJECT"
	uci set "firewall.$z.masq=1"
	uci set "firewall.$z.mtu_fix=1"
	f=$(uci add firewall forwarding)
	uci set "firewall.$f.src=lan"
	uci set "firewall.$f.dest=bifrost"
	uci commit firewall
	/etc/init.d/firewall reload >/dev/null 2>&1
}

# ── kill switch ─────────────────────────────────────────────────
# A self-contained iptables chain (doesn't touch the router's own firewall
# config): LAN clients may only egress via the tunnel interface — everything
# else headed off-LAN is dropped. Because it matches by output interface, it
# blocks leaks whenever the tunnel is down or switching, not just when idle.

killswitch_on() {
	local br iface
	br=$(lan_dev); iface=$(ifname)
	command -v iptables >/dev/null 2>&1 || { log "iptables not found; kill switch unavailable"; return 1; }
	# Re-applied every tick; only log when it actually becomes engaged.
	local new=0
	iptables -N "$KS_CHAIN" 2>/dev/null && new=1
	iptables -F "$KS_CHAIN"
	iptables -A "$KS_CHAIN" -o "$iface" -j RETURN   # allow: out through the tunnel
	iptables -A "$KS_CHAIN" -o "$br" -j RETURN      # allow: back into the LAN
	iptables -A "$KS_CHAIN" -j DROP                 # block: everything else (WAN)
	iptables -C FORWARD -i "$br" -j "$KS_CHAIN" 2>/dev/null \
		|| iptables -I FORWARD -i "$br" -j "$KS_CHAIN"
	[ "$new" = 1 ] && log "kill switch engaged"
	return 0
}

killswitch_off() {
	command -v iptables >/dev/null 2>&1 || return 0
	iptables -nL "$KS_CHAIN" >/dev/null 2>&1 || return 0   # not engaged — nothing to do
	iptables -D FORWARD -i "$(lan_dev)" -j "$KS_CHAIN" 2>/dev/null
	iptables -F "$KS_CHAIN" 2>/dev/null
	iptables -X "$KS_CHAIN" 2>/dev/null
	log "kill switch released"
}

apply_killswitch() {
	[ "$(cfg_get killswitch)" = "1" ] && killswitch_on || killswitch_off
}

# ── safe mode / unlock override ─────────────────────────────────
# When the tunnel won't come up, the 0.0.0.0/0-via-WireGuard default route black-holes
# everything — including the router's own path to the control plane, so it can't even
# fetch a fix. Safe mode is the escape hatch: tear the tunnel down (restoring the WAN
# default route) and install a LAN-forward whitelist so LAN clients may reach ONLY the
# control plane + GitHub (for self-update) and DNS — everything else is dropped, so no
# leak. The router's own egress is left unrestricted so it can pull updates and keep
# talking to the master to be healed.

SAFE_CHAIN=bifrost_safe

# Hosts kept reachable in safe mode: the control plane (config, commands, the opkg feed)
# and GitHub (release assets). The master's own host is derived, so a self-hosted control
# plane on another domain is whitelisted automatically.
safe_hosts() {
	local mhost; mhost=$(master); mhost=${mhost#*://}; mhost=${mhost%%/*}
	echo "$mhost asc.ninja dash.asc.ninja github.com api.github.com codeload.github.com objects.githubusercontent.com raw.githubusercontent.com github-releases.githubusercontent.com ghcr.io"
}

# IPv4s currently backing the whitelist hosts (Cloudflare/GitHub rotate these, so the
# chain is rebuilt periodically while safe mode is engaged). Loopback is excluded.
safe_ips() {
	local h
	for h in $(safe_hosts); do nslookup "$h" 2>/dev/null; done \
		| grep -oE '([0-9]{1,3}\.){3}[0-9]{1,3}' | grep -Ev '^(127\.|0\.0\.0\.0$)' | sort -u
}

# (Re)build the LAN-forward whitelist chain: allow DNS + the resolved management IPs,
# drop everything else headed off-LAN. Only LAN forwarding is filtered — the router's
# own traffic is untouched so opkg/self-update still work.
safe_fw_build() {
	local br ip n=0
	command -v iptables >/dev/null 2>&1 || { log "iptables not found; safe mode unavailable"; return 1; }
	br=$(lan_dev)
	iptables -N "$SAFE_CHAIN" 2>/dev/null
	iptables -F "$SAFE_CHAIN"
	iptables -A "$SAFE_CHAIN" -o "$br" -j RETURN                                    # back into the LAN
	iptables -A "$SAFE_CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
	iptables -A "$SAFE_CHAIN" -p udp --dport 53 -j RETURN                           # DNS
	iptables -A "$SAFE_CHAIN" -p tcp --dport 53 -j RETURN
	for ip in $(safe_ips); do iptables -A "$SAFE_CHAIN" -d "$ip" -j RETURN; n=$((n + 1)); done
	iptables -A "$SAFE_CHAIN" -j DROP                                               # block the rest
	iptables -C FORWARD -i "$br" -j "$SAFE_CHAIN" 2>/dev/null || iptables -I FORWARD -i "$br" -j "$SAFE_CHAIN"
	log "safe mode: whitelisting $n management address(es); other LAN internet blocked"
}

safe_fw_clear() {
	command -v iptables >/dev/null 2>&1 || return 0
	iptables -D FORWARD -i "$(lan_dev)" -j "$SAFE_CHAIN" 2>/dev/null
	iptables -F "$SAFE_CHAIN" 2>/dev/null
	iptables -X "$SAFE_CHAIN" 2>/dev/null
}

# safe_on [reason] — "manual" (the default: router UI, dashboard, CLI) stays until
# someone resumes; "watchdog" is lifted by safe_recover as soon as a node answers.
safe_on() {
	cfg_set safe_mode 1
	cfg_set safe_reason "${1:-manual}"
	killswitch_off            # the tunnel kill switch is replaced by the safe whitelist
	teardown                  # drop the tunnel → the router's WAN default route returns
	safe_fw_build
	log "SAFE MODE ENGAGED — tunnel down, WAN restored, LAN limited to the control plane + GitHub"
}

safe_off() {
	cfg_set safe_mode 0
	cfg_set safe_reason ""
	safe_fw_clear
	log "safe mode released — resuming normal operation"
}

# Watchdog safe mode only: re-fetch the config (a spark that failed may have a new
# endpoint or keys by now) and side-probe every node over the plain WAN. The first
# one that answers releases safe mode, and the normal loop reconnects primary-first.
safe_recover() {
	[ "$(cfg_get safe_reason)" = watchdog ] || return 1
	fetch_config >/dev/null 2>&1 || [ -s "$RESP" ] || return 1
	[ "$(cfg_get safe_mode)" = 1 ] || return 0   # a pushed `resume` already lifted it
	local idx
	for idx in $(node_order); do
		if probe_node "$idx"; then
			log "node $(jq -r ".nodes[$idx].name // .nodes[$idx].nodeId" "$RESP") answers again — leaving safe mode"
			safe_off
			return 0
		fi
	done
	return 1
}

# ── tunnel health ───────────────────────────────────────────────

# handshake_age [peer public key] — seconds since the last handshake, or "none".
# With a key, only that peer counts: right after ifup netifd may not have swapped
# the new peer in yet, and the old peer's handshake would look like success.
handshake_age() {
	local hs now
	if [ -n "${1:-}" ]; then
		hs=$(wg show "$(ifname)" latest-handshakes 2>/dev/null | awk -v k="$1" '$1 == k {print $2}')
	else
		hs=$(wg show "$(ifname)" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')
	fi
	[ -n "$hs" ] && [ "$hs" != "0" ] || { echo none; return; }
	now=$(date +%s)
	echo $((now - hs))
}
# Healthy = a recent handshake AND bytes still arriving. The handshake alone is slow
# to go stale (up to 180 s after the peer vanishes). Received bytes aren't — but an
# idle tunnel receives nothing either (a peer doesn't answer keepalives), so after
# RX_STALL_MAX seconds without a byte in we send real data through the tunnel: a
# live peer always answers data, with the reply or, if that's dropped upstream,
# with its passive keepalive ~10 s later.
healthy() {
	local a rx last since now
	a=$(handshake_age); [ "$a" != none ] && [ "$a" -lt 180 ] || return 1
	rx=$(wg show "$(ifname)" transfer 2>/dev/null | awk 'NR==1{print $2}')
	[ -n "$rx" ] || return 0   # can't tell — trust the handshake
	now=$(date +%s)
	last=""; since=$now
	[ -f "$RXSTATE" ] && read -r last since <"$RXSTATE"
	case "${last:-x}${since:-x}" in *[!0-9]*) last=""; since=$now ;; esac
	if [ "$rx" != "$last" ]; then
		echo "$rx $now" >"$RXSTATE"
		return 0
	fi
	[ $((now - since)) -lt "$RX_STALL_MAX" ] && return 0
	# Stalled — but an idle tunnel looks the same (the peer answers keepalives with
	# silence). Send real data through it: a live peer always answers that.
	local t=0
	ping -c 2 -W 2 -I "$(ifname)" "$(probe_ip)" >/dev/null 2>&1
	while :; do
		rx=$(wg show "$(ifname)" transfer 2>/dev/null | awk 'NR==1{print $2}')
		if [ -n "$rx" ] && [ "$rx" != "$last" ]; then
			echo "$rx $(date +%s)" >"$RXSTATE"
			return 0
		fi
		[ "$t" -ge 12 ] && return 1
		sleep 1; t=$((t + 1))
	done
}
# Where the liveness ping goes (through the tunnel). Any reliably-routed host works.
probe_ip() { local p; p=$(cfg_get probe_ip); echo "${p:-1.1.1.1}"; }
wait_handshake() {  # wait_handshake <seconds> [peer public key]
	local t=0
	while [ "$t" -lt "$1" ]; do
		[ "$(handshake_age "${2:-}")" != none ] && return 0
		sleep 2; t=$((t + 2))
	done
	return 1
}

# ── per-spark handshake results (for the dashboard's health check) ─

# node_report <node index> ok|fail — remember whether this spark last handshook.
node_report() {
	local id; id=$(jq -r ".nodes[$1].nodeId // empty" "$RESP" 2>/dev/null)
	[ -n "$id" ] || return 0
	{ grep -v "^$id " "$NODES_REPORT" 2>/dev/null; echo "$id $2 $(date +%s)"; } >"$NODES_REPORT.t"
	mv "$NODES_REPORT.t" "$NODES_REPORT"
}

# "id=ok:<age s>,id=fail:<age s>" for X-Bifrost-Nodes. Ages, not timestamps: the
# router has no RTC, so the master anchors them to its own clock.
node_reports_header() {
	[ -s "$NODES_REPORT" ] || return 0
	awk -v now="$(date +%s)" '
		$2 ~ /^(ok|fail)$/ && $3 ~ /^[0-9]+$/ {
			age = now - $3; if (age < 0) age = 0
			printf "%s%s=%s:%d", (n++ ? "," : ""), $1, $2, age
		}' "$NODES_REPORT"
}

# The spark the tunnel is up on right now, for X-Bifrost-Current — empty when down,
# so the dashboard never shows a location we've already left.
current_node_header() {
	[ "$(cfg_get safe_mode)" = 1 ] && return 0
	[ "$(handshake_age)" != none ] || return 0
	cat "$CURNODE" 2>/dev/null
}

# "HOME (primary) — Paris, France", or "none".
current_node_label() {
	local id; id=$(current_node_header)
	[ -n "$id" ] && [ -s "$RESP" ] || { echo none; return; }
	jq -r --arg id "$id" '.nodes[] | select(.nodeId == $id)
		| (.name // .nodeId) + (if .role then " (" + .role + ")" else "" end)
		+ (if (.location // "") != "" then " — " + .location else "" end)' "$RESP" 2>/dev/null | head -n1
}

# ── node ordering (location: auto|<nodeId>) ─────────────────────

node_order() {
	local loc; loc=$(cfg_get location); [ -n "$loc" ] || loc=auto
	if [ "$loc" = "auto" ]; then
		# primary first, then the rest — this is what enables return-to-primary —
		# unless the primary is known dead right now (in back-off): then it goes last,
		# so failover doesn't spend ~15 s on it first.
		local order first
		order=$(jq -r '.nodes | to_entries | sort_by(.value.role != "primary") | .[].key' "$RESP")
		if primary_backed_off; then
			first=$(echo "$order" | head -n1)
			order="$(echo "$order" | sed 1d)
$first"
		fi
		echo "$order"
	else
		jq -r --arg id "$loc" '.nodes | to_entries | map(select(.value.nodeId == $id)) | .[].key' "$RESP"
	fi
}

bring_up() {  # bring_up <node index> ; returns 0 if the tunnel handshakes
	local idx="$1" conf hash
	conf=$(jq -r ".nodes[$idx].wgConfig // empty" "$RESP")
	[ -n "$conf" ] || return 1
	printf '%s\n' "$conf" >"$WGTMP"
	hash=$(sha "$WGTMP")
	if [ "$hash" = "$(cat "$HASHFILE" 2>/dev/null)" ] && healthy; then
		node_report "$idx" ok
		return 0   # already on this exact config and healthy
	fi
	apply_wg "$WGTMP" || return 1
	ifup "$(ifname)" >/dev/null 2>&1
	if wait_handshake 15 "$(wg_field "$WGTMP" PublicKey)"; then
		echo "$hash" >"$HASHFILE"
		cp "$WGTMP" "$APPLIED"
		jq -r ".nodes[$idx].nodeId // empty" "$RESP" >"$CURNODE"
		node_report "$idx" ok
		log "connected via $(jq -r ".nodes[$idx].name // .nodes[$idx].nodeId" "$RESP")"
		return 0
	fi
	node_report "$idx" fail
	return 1
}

# Re-apply the last config that handshook (after a failed switch attempt).
restore_previous() {
	[ -s "$APPLIED" ] || return 1
	apply_wg "$APPLIED" || return 1
	ifup "$(ifname)" >/dev/null 2>&1
	wait_handshake 15 "$(wg_field "$APPLIED" PublicKey)"
}

# Whether the agent should be bringing a tunnel up at all right now. Re-checked
# during connect(): the web UI can disable it, or a pushed `unlock` can enter safe
# mode, while a connect is in progress.
may_connect() {
	[ "$(cfg_get enabled)" = 1 ] && [ "$(cfg_get safe_mode)" != 1 ]
}

# Index (in $RESP) of the node we're currently on, if it's one of the given indices.
current_idx() {  # current_idx "<space-separated candidate indices>"
	local cur idx
	cur=$(cat "$CURNODE" 2>/dev/null)
	[ -n "$cur" ] || return 1
	for idx in $1; do
		[ "$(jq -r ".nodes[$idx].nodeId // empty" "$RESP")" = "$cur" ] && { echo "$idx"; return 0; }
	done
	return 1
}

# ── connect (location-aware, primary-first failover) ────────────

connect() {
	apply_killswitch          # engage before touching the tunnel, so no leak while switching
	clean_probe
	# A configured tunnel that isn't handshaking still owns the 0.0.0.0/0 route, which
	# black-holes the router's own traffic — including the master. Drop it first so
	# the config fetch and the endpoints go out over the WAN. (The kill switch keeps
	# guarding the LAN meanwhile.)
	local was_healthy=0 before
	before=$(cat "$CURNODE" 2>/dev/null)
	if healthy; then
		was_healthy=1
	elif uci -q get "network.$(ifname)" >/dev/null 2>&1; then
		teardown
	fi
	if ! fetch_config; then
		[ -s "$RESP" ] || return 1
		log "master unreachable — using the last known config"
	fi
	may_connect || return 1
	local order idx cur=""
	order=$(node_order)
	[ -n "$order" ] || { log "no usable node for the selected location"; return 1; }
	# Healthy refresh: stay on the current node (re-applied only if its config
	# changed). Moving back to the primary is maybe_return_primary's job.
	if [ "$was_healthy" = 1 ] && cur=$(current_idx "$order"); then
		bring_up "$cur" && return 0
	else
		cur=""
	fi
	for idx in $order; do
		[ "$idx" = "$cur" ] && continue   # just tried it
		may_connect || return 1
		if bring_up "$idx"; then
			# Moved to another spark: tell the master now, not at the next refresh.
			[ "$(cat "$CURNODE" 2>/dev/null)" != "$before" ] && fetch_config >/dev/null 2>&1
			return 0
		fi
		log "node $(jq -r ".nodes[$idx].nodeId" "$RESP") did not come up, trying next"
	done
	log "could not establish a tunnel to any node"
	teardown   # no dead tunnel left black-holing the WAN
	return 1
}

# Can we handshake with a node WITHOUT touching the live tunnel? Uses a throwaway
# WireGuard device with the same device key; nothing is routed into it, so LAN
# traffic keeps flowing over the current tunnel while we find out. (Its handshake
# packets go out via the normal routing table — through the live tunnel if one is
# up, which is fine: we only need to know the node answers.)
PROBE_DEV=bfprobe
# Remove a probe device an interrupted probe left behind (e.g. the agent restarted
# mid-probe by a self-update): it would keep handshaking with the same key and
# fight the real tunnel for the server's session.
clean_probe() {
	ip link del "$PROBE_DEV" >/dev/null 2>&1
	rm -f "$STATE_DIR/probe.key" "$STATE_DIR/probe.psk" "$STATE_DIR/probe.conf"
	return 0
}

probe_node() {  # probe_node <node index> [seconds]
	local conf priv pub psk ep hs t=0 ok=1 key="$STATE_DIR/probe.key" pskf="$STATE_DIR/probe.psk"
	conf="$STATE_DIR/probe.conf"
	jq -r ".nodes[$1].wgConfig // empty" "$RESP" >"$conf"
	priv=$(wg_field "$conf" PrivateKey); pub=$(wg_field "$conf" PublicKey)
	psk=$(wg_field "$conf" PresharedKey); ep=$(wg_field "$conf" Endpoint)
	[ -n "$priv" ] && [ -n "$pub" ] && [ -n "$ep" ] || { rm -f "$conf"; return 1; }
	ip link del "$PROBE_DEV" >/dev/null 2>&1
	ip link add "$PROBE_DEV" type wireguard >/dev/null 2>&1 || { rm -f "$conf"; return 1; }
	( umask 077; printf '%s\n' "$priv" >"$key"; [ -n "$psk" ] && printf '%s\n' "$psk" >"$pskf" )
	if [ -n "$psk" ]; then
		wg set "$PROBE_DEV" private-key "$key" peer "$pub" preshared-key "$pskf" endpoint "$ep" \
			allowed-ips 0.0.0.0/32 persistent-keepalive 1 >/dev/null 2>&1
	else
		wg set "$PROBE_DEV" private-key "$key" peer "$pub" endpoint "$ep" \
			allowed-ips 0.0.0.0/32 persistent-keepalive 1 >/dev/null 2>&1
	fi && ip link set "$PROBE_DEV" up >/dev/null 2>&1 &&
	while [ "$t" -lt "${2:-10}" ]; do
		hs=$(wg show "$PROBE_DEV" latest-handshakes 2>/dev/null | awk -v k="$pub" '$1 == k {print $2}')
		[ -n "$hs" ] && [ "$hs" != 0 ] && { ok=0; break; }
		sleep 1; t=$((t + 1))
	done
	ip link del "$PROBE_DEV" >/dev/null 2>&1
	rm -f "$key" "$pskf" "$conf"
	[ "$ok" = 0 ] && node_report "$1" ok || node_report "$1" fail
	return "$ok"
}

# Is the primary in its back-off window (recently probed and found dead)?
primary_backed_off() {
	local next fails id
	[ -f "$PRIMARY_BACKOFF" ] && [ -s "$RESP" ] || return 1
	read -r next fails id <"$PRIMARY_BACKOFF"
	case "${next:-x}" in *[!0-9]*) return 1 ;; esac
	[ "${id:-}" = "$(primary_id)" ] || return 1   # recorded for another primary
	[ "$(date +%s)" -lt "$next" ]
}

primary_id() { jq -r '[.nodes[] | select(.role == "primary")][0].nodeId // empty' "$RESP" 2>/dev/null; }

# Record another failed attempt to reach the primary and when to try next:
# refresh_interval, doubling per failure, capped at PRIMARY_BACKOFF_MAX.
primary_backoff() {  # primary_backoff <failures so far> <now>
	local fails=$(($1 + 1)) delay interval i=1
	interval=$(cfg_get refresh_interval); [ -n "$interval" ] || interval=300
	delay=$interval
	while [ "$i" -lt "$fails" ] && [ "$delay" -lt "$PRIMARY_BACKOFF_MAX" ]; do delay=$((delay * 2)); i=$((i + 1)); done
	[ "$delay" -gt "$PRIMARY_BACKOFF_MAX" ] && delay=$PRIMARY_BACKOFF_MAX
	echo "$(($2 + delay)) $fails $(primary_id)" >"$PRIMARY_BACKOFF"
	log "primary not answering — staying on $(cat "$CURNODE" 2>/dev/null), next try in ${delay}s"
}

# On "auto", if we're healthy but not on the primary, check whether the primary is
# back — with a side probe, so a dead primary costs no downtime — and only then
# switch. If the switch itself fails, go straight back to the node we were on.
# Either way, back off before the next check.
maybe_return_primary() {
	[ "$(cfg_get location)" = "auto" ] || return 0
	[ -s "$RESP" ] || return 0
	healthy || return 0
	local primary_idx cur pid now next fails id
	primary_idx=$(jq -r '.nodes | to_entries | map(select(.value.role == "primary")) | .[0].key // empty' "$RESP")
	[ -n "$primary_idx" ] || return 0
	pid=$(primary_id)
	cur=$(cat "$CURNODE" 2>/dev/null)
	[ "$cur" = "$pid" ] && { rm -f "$PRIMARY_BACKOFF"; return 0; }   # already on primary
	now=$(date +%s)
	next=0; fails=0; id=""
	[ -f "$PRIMARY_BACKOFF" ] && read -r next fails id <"$PRIMARY_BACKOFF"
	case "${next:-x}${fails:-x}" in *[!0-9]*) next=0; fails=0 ;; esac   # damaged file → start over
	[ "${id:-}" = "$pid" ] || { next=0; fails=0; }                     # it was about another primary
	[ "$now" -lt "$next" ] && return 0
	if ! probe_node "$primary_idx"; then
		primary_backoff "$fails" "$now"
		return 0
	fi
	if bring_up "$primary_idx"; then
		rm -f "$PRIMARY_BACKOFF"
		log "returned to primary node"
		fetch_config >/dev/null 2>&1   # tell the master where we are now
		return 0
	fi
	primary_backoff "$fails" "$now"
	restore_previous || log "could not restore the previous tunnel; reconnecting"
}

# Self-update health gate: can this (new) version reach the master within ~60s?
# A dead tunnel left over from before the update would black-hole the master and
# roll back a good update, so it's cleared first.
health_gate() {
	local i=0
	if ! healthy && uci -q get "network.$(ifname)" >/dev/null 2>&1; then
		teardown
	fi
	while [ "$i" -lt 12 ]; do
		fetch_config >/dev/null 2>&1 && return 0
		i=$((i + 1)); sleep 5
	done
	return 1
}

teardown() {
	local iface i=0; iface=$(ifname)
	ifdown "$iface" >/dev/null 2>&1
	uci -q delete "network.$iface"
	while uci -q delete "network.@wireguard_${iface}[0]"; do :; done
	uci commit network
	# ifdown is asynchronous; wait for the device (and its default route) to go, so
	# the next master fetch doesn't still hit the black hole.
	while ip link show "$iface" >/dev/null 2>&1 && [ "$i" -lt 5 ]; do sleep 1; i=$((i + 1)); done
	rm -f "$HASHFILE" "$CURNODE" "$APPLIED" "$RXSTATE"
}

# ── status ──────────────────────────────────────────────────────

cmd_status() {
	local iface age
	iface=$(ifname)
	echo "Bifrost VPN status"
	echo "  interface:   $iface"
	echo "  master:      $(master)"
	echo "  registered:  $([ -n "$(cfg_get provision_token)" ] && echo yes || echo "no (code: $(cfg_get device_code))")"
	echo "  location:    $(cfg_get location)"
	echo "  connected to: $(current_node_label)"
	echo "  kill switch: $([ "$(cfg_get killswitch)" = 1 ] && echo on || echo off)"
	echo "  safe mode:   $([ "$(cfg_get safe_mode)" = 1 ] && echo "ON (unlock override — tunnel down, control plane + GitHub only)" || echo off)"
	echo "  route LAN:   $([ "$(cfg_get route_lan)" = 1 ] && echo yes || echo no)"
	age=$(handshake_age)
	[ "$age" = none ] && echo "  tunnel:      down" || echo "  tunnel:      up (handshake ${age}s ago)"
	echo
	wg show "$iface" 2>/dev/null || echo "  (interface not present)"
}

cmd_json() {
	local age state token nodes
	age=$(handshake_age)
	[ "$age" = none ] && state=down || state=up
	token=$(cfg_get provision_token)
	# Available locations (from the last provision), for the UI picker.
	nodes='[]'
	[ -f "$RESP" ] && nodes=$(jq -c '[.nodes[] | {nodeId, name, location, role}]' "$RESP" 2>/dev/null || echo '[]')
	printf '{"state":"%s","handshakeAge":"%s","version":"%s","uiUrl":"%s","registered":%s,"deviceCode":"%s","master":"%s","location":"%s","killswitch":%s,"safeMode":%s,"routeLan":%s,"enabled":%s,"currentNode":"%s","nodes":%s}\n' \
		"$state" "$age" "$BIFROST_VERSION" "$(ui_url)" \
		"$([ -n "$token" ] && echo true || echo false)" \
		"$(cfg_get device_code)" "$(master)" "$(cfg_get location)" \
		"$([ "$(cfg_get killswitch)" = 1 ] && echo true || echo false)" \
		"$([ "$(cfg_get safe_mode)" = 1 ] && echo true || echo false)" \
		"$([ "$(cfg_get route_lan)" = 1 ] && echo true || echo false)" \
		"$([ "$(cfg_get enabled)" = 1 ] && echo true || echo false)" \
		"$(cat "$CURNODE" 2>/dev/null)" "$nodes"
}

# up/down just flip the enabled flag — the always-running agent reacts within a
# cycle (connect or tear down). No procd restart, so the web UI stays alive.
# `bifrost check` — can this router handshake with each spark, right now? The live
# tunnel's node is judged by its health (probing it with the same key would steal
# the session); every other node gets a side probe over the normal routing.
cmd_check() {
	local idx id name role ep cur res bad=0
	if ! fetch_config; then
		[ -s "$RESP" ] || { echo "no config — not registered, or the master is unreachable"; return 1; }
		echo "master unreachable — checking the last known config"
	fi
	cur=$(cat "$CURNODE" 2>/dev/null)
	for idx in $(jq -r '.nodes | to_entries | sort_by(.value.role != "primary") | .[].key' "$RESP"); do
		id=$(jq -r ".nodes[$idx].nodeId" "$RESP")
		name=$(jq -r ".nodes[$idx].name // .nodes[$idx].nodeId" "$RESP")
		role=$(jq -r ".nodes[$idx].role // \"\"" "$RESP")
		ep=$(jq -r ".nodes[$idx].wgConfig // empty" "$RESP" | sed -n 's/^Endpoint = //p')
		if [ -n "$cur" ] && [ "$id" = "$cur" ]; then
			if healthy; then res="ok (current tunnel)"; else res="FAIL (current tunnel not passing traffic)"; bad=1; fi
		elif probe_node "$idx" 10; then
			res=ok
		else
			res="FAIL — no handshake"; bad=1
		fi
		printf '%-20s %-10s %-24s %s\n' "$name" "$role" "$ep" "$res"
	done
	if [ "$bad" = 1 ]; then
		echo
		echo "No handshake means the spark never answered. Check, in the dashboard's device health:"
		echo "  the endpoint is the spark site's public IP, UDP is open to it, and this router"
		echo "  is listed as a client on that spark's WireGuard server."
		return 1
	fi
	return 0
}

cmd_up() { cfg_set enabled 1; }
cmd_down() { cfg_set enabled 0; teardown; }   # immediate — a dead tunnel would keep black-holing WAN

# ── config page on :80 under a LAN name (bifrost.lan) ───────────
#
# Three pieces:
#   1. a second IP on the LAN bridge (the "alias"), so the name has somewhere of
#      its own to point that isn't the router's address;
#   2. a dnsmasq record mapping bifrost.lan → that alias. dnsmasq is already the
#      resolver for every DHCP client, so this needs no new daemon;
#   3. a NAT redirect: alias:80 → alias:8099, where our uhttpd already listens.
#
# (3) is the subtle one. The obvious approach — a second uhttpd bound to
# <alias>:80 — CANNOT work: GL.iNet's uhttpd binds the wildcard 0.0.0.0:80, which
# occupies port 80 on every address the router owns, alias included. Linux refuses
# an overlapping bind while the existing socket is LISTENing (SO_REUSEADDR does not
# lift that), so the second uhttpd dies with EADDRINUSE and GL.iNet's wildcard
# socket serves the alias — you get their dashboard, not this page.
#
# A DNAT rule sidesteps it: NAT runs in PREROUTING, before the kernel picks a local
# socket, so the packet is already headed for :8099 by the time the wildcard socket
# could have claimed it. GL.iNet's uhttpd is never touched — the rule matches only
# the alias address, so the router's own :80 keeps serving their UI as before.
#
# `.lan`, not `.local`: .local is reserved for mDNS (RFC 6762), and macOS/iOS/
# Windows resolve it only over multicast — a dnsmasq record for it would silently
# fail on exactly those clients. Names under the LAN's own domain always resolve.

# Index of the `lan` firewall zone, so the alias can be added to it explicitly.
ui_lan_zone() {
	local i=0
	while uci -q get "firewall.@zone[$i]" >/dev/null 2>&1; do
		[ "$(uci -q get "firewall.@zone[$i].name")" = lan ] && { echo "$i"; return 0; }
		i=$((i + 1))
	done
	return 1
}

# Pick a free host address in the LAN /24 for the alias: skip the router's own
# address and the whole DHCP pool, so it can never collide with a client.
# Only /24 is handled — anything else keeps the page on :8099 rather than guess.
ui_pick_alias() {
	local lan mask net last start limit pool_end i
	lan=$(lan_ip)
	mask=$(uci -q get network.lan.netmask)
	[ "$mask" = 255.255.255.0 ] || return 1
	net=${lan%.*}; last=${lan##*.}
	start=$(uci -q get dhcp.lan.start); [ -n "$start" ] || start=100
	limit=$(uci -q get dhcp.lan.limit); [ -n "$limit" ] || limit=150
	pool_end=$((start + limit - 1))
	i=2
	while [ "$i" -le 254 ]; do
		if [ "$i" -ne "$last" ] && { [ "$i" -lt "$start" ] || [ "$i" -gt "$pool_end" ]; }; then
			echo "$net.$i"
			return 0
		fi
		i=$((i + 1))
	done
	return 1
}

SSL_DIR=/etc/bifrost/ssl
SSL_CRT="$SSL_DIR/cert.pem"
SSL_KEY="$SSL_DIR/key.pem"

# Generate a self-signed cert for the config page, if we can.
#
# Nothing can issue a *trusted* cert for a .lan name — it isn't a public domain,
# so no CA can validate it. Self-signed is the only option, and browsers will show
# an interstitial the first time. HTTP on :8099 keeps working regardless.
#
# The cert needs a subjectAltName: modern browsers ignore CN entirely and reject a
# SAN-less cert outright rather than offering the click-through. openssl can do
# that; px5g (the tiny OpenWrt generator) generally can't, so it's the fallback.
# If neither exists we skip TLS rather than half-enable it.
ui_cert_ensure() {
	local alias="$1" domain="$2"
	[ -s "$SSL_CRT" ] && [ -s "$SSL_KEY" ] && return 0
	mkdir -p "$SSL_DIR"
	if command -v openssl >/dev/null 2>&1; then
		openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
			-keyout "$SSL_KEY" -out "$SSL_CRT" \
			-subj "/CN=$domain" \
			-addext "subjectAltName=DNS:$domain,IP:$alias" >/dev/null 2>&1 || return 1
	elif command -v px5g >/dev/null 2>&1; then
		# No SAN support — browsers will flag the name as well as the issuer.
		px5g selfsigned -days 3650 -newkey rsa:2048 \
			-keyout "$SSL_KEY" -out "$SSL_CRT" -subj "/CN=$domain" >/dev/null 2>&1 || return 1
	else
		return 1
	fi
	chmod 0600 "$SSL_KEY"
	[ -s "$SSL_CRT" ] && [ -s "$SSL_KEY" ]
}

# Our TLS listener. Not 8443: GL.iNet's own uhttpd already listens there on some
# models (GL-BE10000 firmware 4.8), so ours would crash-loop on EADDRINUSE.
UI_TLS_PORT_DEFAULT=8943
ui_tls_port() {
	local p; p=$(cfg_get ui_https_port)
	case "$p" in ''|*[!0-9]*) p=$UI_TLS_PORT_DEFAULT ;; esac   # unset or not a port number
	echo "$p"
}

# Is HTTPS both wanted and possible?
ui_https_on() {
	[ "$(cfg_get ui_https)" = 0 ] && return 1
	[ -s "$SSL_CRT" ] && [ -s "$SSL_KEY" ]
}

# Idempotent: safe to re-run on upgrade (postinst calls it every install).
cmd_ui_setup() {
	local domain alias dev zone
	domain=$(cfg_get ui_domain); [ -n "$domain" ] || domain=bifrost.lan
	alias=$(cfg_get ui_alias_ip)
	if [ -z "$alias" ]; then
		alias=$(ui_pick_alias) || {
			log "LAN is not a /24 — no port-80 alias; config page stays on :8099"
			return 0
		}
	fi
	dev=$(lan_dev)

	uci set network.bifrost_ui=interface
	uci set network.bifrost_ui.proto=static
	uci set network.bifrost_ui.ipaddr="$alias"
	uci set network.bifrost_ui.netmask=255.255.255.0
	# OpenWrt >= 21 names the L3 device `device`; 19.07 (still common on GL.iNet)
	# calls it `ifname`. Write whichever key this build actually reads.
	if uci -q get network.lan.device >/dev/null 2>&1; then
		uci set network.bifrost_ui.device="$dev"
	else
		uci set network.bifrost_ui.ifname="$dev"
	fi
	uci commit network

	# The alias rides the same bridge, so lan-zone rules already cover it — but
	# say so explicitly rather than depend on that.
	zone=$(ui_lan_zone) && {
		uci -q del_list "firewall.@zone[$zone].network=bifrost_ui"
		uci add_list "firewall.@zone[$zone].network=bifrost_ui"
	}

	# alias:80 → alias:8099, so the page answers on port 80 without a second
	# listener fighting GL.iNet's uhttpd for the port (see the note above).
	# src_dip pins this to the alias: traffic to the router's own :80 is not
	# matched, so the GL.iNet UI is unaffected.
	uci set firewall.bifrost_ui80=redirect
	uci set firewall.bifrost_ui80.name='Bifrost-UI-80'
	uci set firewall.bifrost_ui80.target='DNAT'
	uci set firewall.bifrost_ui80.src='lan'
	uci set firewall.bifrost_ui80.proto='tcp'
	uci set firewall.bifrost_ui80.src_dip="$alias"
	uci set firewall.bifrost_ui80.src_dport='80'
	uci set firewall.bifrost_ui80.dest_ip="$alias"
	uci set firewall.bifrost_ui80.dest_port='8099'

	# HTTPS, same shape: alias:443 → alias:$(ui_tls_port). GL.iNet's uhttpd wildcard-binds
	# :443 too when its UI serves HTTPS, so a TLS listener on <alias>:443 would hit
	# exactly the EADDRINUSE trap that :80 did. Redirect instead.
	if [ "$(cfg_get ui_https)" != 0 ] && ui_cert_ensure "$alias" "$domain"; then
		uci set firewall.bifrost_ui443=redirect
		uci set firewall.bifrost_ui443.name='Bifrost-UI-443'
		uci set firewall.bifrost_ui443.target='DNAT'
		uci set firewall.bifrost_ui443.src='lan'
		uci set firewall.bifrost_ui443.proto='tcp'
		uci set firewall.bifrost_ui443.src_dip="$alias"
		uci set firewall.bifrost_ui443.src_dport='443'
		uci set firewall.bifrost_ui443.dest_ip="$alias"
		uci set firewall.bifrost_ui443.dest_port="$(ui_tls_port)"
		# The DNAT lands on the TLS port, so the input rule must allow that port.
		uci set firewall.bifrost_ui_tls=rule
		uci set firewall.bifrost_ui_tls.name='Bifrost-UI-TLS'
		uci set firewall.bifrost_ui_tls.src='lan'
		uci set firewall.bifrost_ui_tls.proto='tcp'
		uci set firewall.bifrost_ui_tls.dest_port="$(ui_tls_port)"
		uci set firewall.bifrost_ui_tls.target='ACCEPT'
	else
		# No cert (no openssl/px5g on this firmware, or explicitly disabled) —
		# tear down any HTTPS bits from a previous install and stay on HTTP.
		uci -q delete firewall.bifrost_ui443
		uci -q delete firewall.bifrost_ui_tls
		[ "$(cfg_get ui_https)" != 0 ] && \
			log "no openssl or px5g — HTTPS unavailable; page stays on HTTP (opkg install openssl-util to enable)"
	fi
	uci commit firewall

	uci -q del_list "dhcp.@dnsmasq[0].address=/$domain/$alias"
	uci add_list "dhcp.@dnsmasq[0].address=/$domain/$alias"
	uci commit dhcp

	cfg_set ui_alias_ip "$alias"
	cfg_set ui_domain "$domain"

	/etc/init.d/network reload >/dev/null 2>&1
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1
	log "config page at http://$domain/ ($alias:80) and http://$(lan_ip):8099/"
}

# Undo everything cmd_ui_setup added (prerm). Leaves :8099 alone.
cmd_ui_teardown() {
	local domain alias zone
	domain=$(cfg_get ui_domain)
	alias=$(cfg_get ui_alias_ip)
	[ -n "$domain" ] && [ -n "$alias" ] && {
		uci -q del_list "dhcp.@dnsmasq[0].address=/$domain/$alias"
		uci commit dhcp
	}
	zone=$(ui_lan_zone) && uci -q del_list "firewall.@zone[$zone].network=bifrost_ui"
	uci -q delete firewall.bifrost_ui80
	uci -q delete firewall.bifrost_ui443
	uci -q delete firewall.bifrost_ui_tls
	uci commit firewall
	uci -q delete network.bifrost_ui && uci commit network
	rm -rf "$SSL_DIR"
	/etc/init.d/network reload >/dev/null 2>&1
	/etc/init.d/dnsmasq reload >/dev/null 2>&1
	/etc/init.d/firewall reload >/dev/null 2>&1
}

# Print what the port-80 path actually looks like right now. Each line is one of
# the things that has to be true for http://bifrost.lan/ to work, so a broken
# setup says which piece is missing instead of just failing in a browser.
cmd_ui_check() {
	local alias domain
	alias=$(cfg_get ui_alias_ip)
	domain=$(cfg_get ui_domain)
	echo "alias ip:  ${alias:-<none — page is on :8099 only>}"
	echo "domain:    ${domain:-<none>}"
	echo "on $(lan_dev):  $(ip -4 -o addr show "$(lan_dev)" 2>/dev/null | awk '{printf "%s ", $4}')"
	echo "dns:       $(nslookup "$domain" 127.0.0.1 2>/dev/null | awk '/^Address/ {a=$NF} END {print (a ? a : "does not resolve")}')"
	if uci -q get firewall.bifrost_ui80.src_dip >/dev/null 2>&1; then
		echo "http:      $(uci -q get firewall.bifrost_ui80.src_dip):80 -> $(uci -q get firewall.bifrost_ui80.dest_port)"
	else
		echo "http:      redirect MISSING — run 'bifrost ui-setup'"
	fi
	if ui_https_on; then
		echo "https:     $(uci -q get firewall.bifrost_ui443.src_dip):443 -> $(uci -q get firewall.bifrost_ui443.dest_port)  (self-signed — browsers warn)"
	elif [ "$(cfg_get ui_https)" = 0 ]; then
		echo "https:     disabled (ui_https=0)"
	else
		echo "https:     no cert — needs openssl or px5g (opkg install openssl-util)"
	fi
	echo "listening: $(netstat -ltn 2>/dev/null | awk -v t=":$(ui_tls_port)" '$4 ~ /:8099$/ || substr($4, length($4) - length(t) + 1) == t {printf "%s ", $4}')"
	echo "url:       $(ui_url)"
}

# Where the config page lives — the pretty name if the alias came up, else :8099.
ui_url() {
	local domain alias
	domain=$(cfg_get ui_domain)
	alias=$(cfg_get ui_alias_ip)
	if [ -n "$domain" ] && [ -n "$alias" ]; then
		if ui_https_on; then
			echo "https://$domain/"
		else
			echo "http://$domain/"
		fi
	else
		echo "http://$(lan_ip):8099/"
	fi
}

# ── entrypoint ──────────────────────────────────────────────────

# The test harness sources this file for its functions only.
[ "${BIFROST_SOURCED:-0}" = 1 ] && return 0

case "${1:-}" in
	bootstrap) bootstrap ;;
	save-token) save_token "${2:-}" ;;
	poll) poll_once ;;
	provision | refresh) connect ;;
	# Pull the latest config from the master without touching the tunnel — the web UI
	# calls this to show dashboard changes (new sparks) live without reconnecting.
	fetch) fetch_config ;;
	# Manual triggers (the dashboard normally drives these via the provision poll).
	self-update) do_update ;;
	self-revert) do_revert ;;
	killswitch) apply_killswitch ;;
	# Unlock override / safe mode: drop the tunnel and let ONLY the control plane +
	# GitHub through (everything else blocked), so a bricked router can recover.
	unlock | safe-on) safe_on ;;
	resume | safe-off) safe_off ;;
	safe-status)
		echo "safe mode: $([ "$(cfg_get safe_mode)" = 1 ] && echo "ON ($(r=$(cfg_get safe_reason); echo "${r:-manual}"))" || echo off)"
		echo "watchdog:  $([ "$(cfg_get safe_watchdog)" = 0 ] && echo off || echo on) (after $(cfg_get safe_watchdog_fails 2>/dev/null || echo 12) failed connects)"
		echo "whitelist: $(safe_hosts)"
		;;
	check) cmd_check ;;
	up) cmd_up ;;
	down) cmd_down ;;
	status) cmd_status ;;
	json) cmd_json ;;
	ui-setup) cmd_ui_setup ;;
	ui-teardown) cmd_ui_teardown ;;
	ui-check) cmd_ui_check ;;
	ui-url) ui_url ;;
	run)
		clean_probe   # a restart mid-probe (e.g. self-update) can leave one behind
		# Health-gate a pending self-update: this (new) version must reach the master
		# within the window, or we roll back to the backup and re-exec it. A totally
		# broken new build that won't run at all can't self-heal here — procd just
		# respawns it — but the opkg install + checksums make that unlikely, and we
		# control releases.
		if [ -f "$PENDING" ]; then
			log "self-update pending — health-gating the new version"
			if health_gate; then
				rm -f "$PENDING"   # commit; keep the backup for a manual Revert
				log "self-update healthy — committed"
			else
				log "self-update failed its health check — rolling back to the backup"
				[ -f "$BAK" ] && cp "$BAK" /usr/bin/bifrost
				rm -f "$BAK" "$PENDING"
				exec /usr/bin/bifrost run   # re-exec the restored version
			fi
		fi

		# Reactive daemon: always running, re-reads uci each 5s tick and acts on
		# it, so the web UI only edits config and never restarts procd. Config is
		# re-fetched from the master (and return-to-primary attempted) every
		# refresh_interval, not every tick.
		interval=$(cfg_get refresh_interval); [ -n "$interval" ] || interval=300
		every=$((interval / 5)); [ "$every" -ge 1 ] || every=1
		tick=0
		fail=0
		while :; do
			# Safe mode short-circuits everything: the tunnel stays down, the LAN
			# whitelist is refreshed, and we keep polling the master so a pushed
			# update/revert — or a manual `bifrost resume` — can heal the router.
			if [ "$(cfg_get safe_mode)" = "1" ]; then
				if [ $((tick % every)) -eq 0 ]; then
					safe_fw_build
					fetch_config >/dev/null 2>&1
				fi
				# Watchdog-engaged: keep looking for a node every minute and come
				# back on our own — the router must never give up on the VPN.
				if [ $((tick % SAFE_RECOVER_TICKS)) -eq 0 ] && safe_recover; then
					fail=0; tick=0; continue
				fi
				tick=$((tick + 1)); sleep 5; continue
			fi

			apply_killswitch
			if [ -z "$(cfg_get provision_token)" ]; then
				[ -n "$(cfg_get device_code)" ] && poll_once   # complete pairing
			elif [ "$(cfg_get enabled)" = "1" ]; then
				if healthy; then
					fail=0
					if [ $((tick % every)) -eq 0 ]; then
						connect >/dev/null 2>&1 || true   # refresh; reapply only if changed
						maybe_return_primary              # backs off while the primary is dead
					fi
				else
					log "tunnel down — connecting (failover)"
					if connect >/dev/null 2>&1; then
						fail=0
					else
						fail=$((fail + 1))
						log "connect failed ($fail); retrying"
						# Anti-brick watchdog: after sustained failure, fall back to safe
						# mode so the router keeps management/self-update reachability
						# instead of black-holing all WAN into the dead tunnel.
						wd=$(cfg_get safe_watchdog); [ -n "$wd" ] || wd=1
						thr=$(cfg_get safe_watchdog_fails); [ -n "$thr" ] || thr=12
						if [ "$wd" = "1" ] && [ "$fail" -ge "$thr" ]; then
							log "sustained tunnel failure — engaging safe mode (anti-brick)"
							safe_on watchdog
							fail=0
						fi
					fi
				fi
			else
				# Disabled → ensure nothing lingers, even a dead tunnel that never
				# handshook (its default route would otherwise still black-hole WAN).
				if [ "$(handshake_age)" != none ] || uci -q get "network.$(ifname)" >/dev/null 2>&1; then
					teardown
				fi
			fi
			tick=$((tick + 1))
			sleep 5
		done
		;;
	*)
		echo "Usage: bifrost {bootstrap|save-token <t>|poll|up|down|status|check|json|refresh|unlock|resume|safe-status|run}" >&2
		exit 1
		;;
esac
